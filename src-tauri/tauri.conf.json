{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeriphHub",
  "version": "0.16.0",
  "identifier": "io.github.sharkytihno.periphhub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PeriphHub",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion,AutofillServerCommunication,OptimizationHints,MediaRouter,Translate --enable-features=NetworkServiceInProcess2 --in-process-gpu --renderer-process-limit=1 --disable-background-networking --disable-component-update --disable-extensions --disable-sync --no-pings --js-flags=--lite-mode"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NTVERjY2MENENzlBM0EKUldRNm10Y01adDlWWmNQc25UMjllOWQ4MnVJS2IzMWpOY3hTR3ZPWUhyMmlNZ0d1WnlqMEVhMEIK",
      "endpoints": ["https://github.com/Sharkytihno/PeriphHub/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/headsetcontrol.exe"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Un seul logiciel léger pour tous vos périphériques",
    "publisher": "PeriphHub",
    "copyright": "GPL-3.0-or-later"
  }
}
